                    if (cellValue.indexOf("<SPDataPrincipals>") >= 0) {
                        var xml = $.parseXML(cellValue);
                        $("SPDataPrincipal", xml).each(function () {
                            var t = $(this);
                            users.push({
                                Id: t.attr("Id"),
                                Key: t.attr("LoginName"),
                                DisplayText: t.attr("Name")
                            });
                        });
                        fnResolvedUsers(users);
                        allResolved = true;
                    }
                    else if (cellValue.indexOf("[") == 0 || cellValue.indexOf("{") == 0) {
                        if (cellValue.indexOf("[") == 0) {
                            users = JSON.parse(cellValue);
                        }
                        else {
                            var item = JSON.parse(cellValue);
                            users.push(item);
                        }
                        allResolved = true;
                        var resolvedUsers = [];
                        for (var i = 0; i < users.length; i++) {
                            var u = users[i];
                            if (u.DisplayText.indexOf("\\") > 0 && u.Key.indexOf("c:0+.w|") < 0) {
                                allResolved = false;
                                var loginName = u.Key;
                                if (loginName.indexOf("|") > 0)
                                    loginName = loginName.split("|").pop();
                                unresolvedUsers.push(loginName);
                            }
                            else
                                resolvedUsers.push(u);
                        }
                        if (allResolved && fnResolvedUsers)
                            fnResolvedUsers(resolvedUsers);
                        if (!allResolved && fnUnresolvedUsers)
                            fnUnresolvedUsers(unresolvedUsers);
                    }
                    else {
                        var arr = cellValue.split(';');
                        for (var i = 0; i < arr.length; i++) {
                            var a = arr[i];
                            if (a.indexOf("|") > 0)
                                a = a.split("|").pop();
