function drawTable(fn, o, days) {
  var table = $(".rq-h-number");

  var v = TiSa.Forms.CurrentForm.FieldsByName.Rq_H_TypeOfHoliday.GetValue();

  $(".rq-h-row-base > .v1", table).text(fn(o.drawn));
  $(".rq-h-row-free > .v1", table).text(fn(o.drawnFree));
  $(".rq-h-row-senior > .v1", table).text(fn(o.drawnSenior));
  $(".rq-h-row-sum > .v1", table).text(fn(o.drawn + o.drawnFree + o.drawnSenior));

  $(".rq-h-row-base > .v2", table).text(fn(o.remains));
  $(".rq-h-row-free > .v2", table).text(fn(o.remainsFree));
  $(".rq-h-row-senior > .v2", table).text(fn(o.remainsSenior));
  $(".rq-h-row-sum > .v2", table).text(fn(o.remains + o.remainsFree + o.remainsSenior - o.forApprove));

  if (o.forApprove > 0) {
    $(".rq-h-row-app").show();
    $(".rq-h-row-app > .v2", table).text(fn(-o.forApprove));
  }

  if (v == "Dovolená") {
    $(".rq-h-row-sum > .v3", table).text(fn(o.remains + o.remainsFree + o.remainsSenior - o.forApprove - days));
    $(".v3", table).show();
  } else {
    $(".rq-h-row-sum > .v3", table).text(fn(o.remains + o.remainsFree + o.remainsSenior - o.forApprove));
    $(".v3", table).hide();
  }
  if (o.drawnSenior > 0 || o.remainsSenior > 0)
    $(".rq-h-row-senior").show();

}

function isInt(value) {
  var x;
  if (isNaN(value)) {
    return false;
  }
  x = parseFloat(value);
  return (x | 0) === x;
}

function existsAnotherHolidayAt(arr, except, d) {
  for (var i = 0; i < arr.length; i++) {
    if (i == except)
      continue;
    var b = arr[i];
    if (d.getTime() == b.Start.getTime() || d.getTime() == b.End.getTime()) {
      return true;
    }
  }
  return false;
}

function testHolidayCollisions(start, end, days, arr) {
  var half = !isInt(days);
  for (var i = 0; i < arr.length; i++) {
    var a = arr[i];
    var h = !isInt(a.Days);
    if (start.getTime() >= a.Start.getTime() && start.getTime() <= a.End.getTime() || end.getTime() >= a.Start.getTime() && end.getTime() <= a.End.getTime()) {

      // vyšetření okrajových podmínek
      if (h && (start.getTime() == a.End.getTime() || end.getTime() == a.Start.getTime())) {
        var clearStart = !existsAnotherHolidayAt(arr, i, start);
        var clearEnd = !existsAnotherHolidayAt(arr, i, end);

        if (start.getTime() == end.getTime()) {
          if (clearStart && clearEnd) {
            TiSa.Console.Log("HolidayCollisions: vyjímka přidání půldne na již existující půlden");
            continue; // přidání půldne na již existující půlden
          }
        } else {
          if (start.getTime() == a.End.getTime() && clearStart) {
            TiSa.Console.Log("HolidayCollisions: vyjímka pokud je možno překrývat půlden na začátku");
            continue; // pokud je možno překrývat půlden na začátku
          } else if (end.getTime() == a.Start.getTime() && clearEnd) {
            TiSa.Console.Log("HolidayCollisions: vyjímka pokud je možno překrývat půlden na konci");
            continue; // pokud je možné překrývat půlden na konci
          }
        }
      }

      return true;
    }
  }
  return false;
}

function SetHolidayWarning(isWarn, reason) {
  var formContext = TiSa.Forms.CurrentForm.FormContext;
  var ct_Rq_H_ValidSince = formContext.FindFieldControl("Rq_H_ValidSince");
  var ct_Rq_H_ValidTo = formContext.FindFieldControl("Rq_H_ValidTo");
  var ct_Rq_H_WorkingDay = formContext.FindFieldControl("Rq_H_WorkingDay");
  ct_Rq_H_ValidSince.GetInput().toggleClass("rq-h-warning", isWarn);
  ct_Rq_H_ValidTo.GetInput().toggleClass("rq-h-warning", isWarn);
  ct_Rq_H_WorkingDay.GetInput().toggleClass("rq-h-warning", isWarn);
  $(".rq-h-warningText").toggle(isWarn);
  switch (reason) {
    case 0:
      $(".rq-h-warningText").text("");
      break;
    case 1:
      $(".rq-h-warningText").text("Dovolenou nelze plánovat v přechozím roce");
