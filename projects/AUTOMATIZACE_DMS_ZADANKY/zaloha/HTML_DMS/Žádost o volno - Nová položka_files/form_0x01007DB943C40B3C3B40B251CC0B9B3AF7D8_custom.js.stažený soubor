      break;
    case 3:
      $(".rq-h-warningText").text("Nelze naplánovat dovolenou delší, než na jakou máte nárok");
      break;
    case 4:
      $(".rq-h-warningText").text("Prozatím nelze plánovat dovolenou v následujícím roce");
      break;
    case 5:
      $(".rq-h-warningText").text("Nelze naplánovat dovolenou delší, než na jakou máte nárok v následujícím roce");
      break;
    case 6:
      $(".rq-h-warningText").text("V tomto termínu již máte naplánované nebo schválené volno");
      break;
    case 7:
      $(".rq-h-warningText").text("V aktuálním roce nemáte nárok na žádnou dovolenou");
      break;
    case 8:
      $(".rq-h-warningText").text("Ve vybraném období nejsou žádné pracovní dny");
      break;
    case 9:
      $(".rq-h-warningText").text("Na tento rok již nelze plánovat dovolenou, ale můžete již plánovat dovolenou na příští rok");
      break;
  }
  var val = TiSa.Forms.Utils.GetValidatorByType(ct_Rq_H_WorkingDay.Validators, "number");
  val.SetDisabled(!isWarn);

  if (isWarn)
    $("head").append("<style type='text/css' id='rq-h-saveButtonStyle'>#Ribbon\\.ListForm\\.Edit\\.Commit\\.Publish-Large, #TiSa\\.Copy\\.SectionCopy {display:none !important}</style>");
  else
    $("#rq-h-saveButtonStyle").remove();

  setTimeout(function() {
    if (isWarn)
      $("head").append("<style type='text/css' id='rq-h-saveButtonStyle'>#Ribbon\\.ListForm\\.Edit\\.Commit\\.Publish-Large, #TiSa\\.Copy\\.SectionCopy {display:none !important}</style>");
    else
      $("#rq-h-saveButtonStyle").remove();
  }, 100);

  $("[id$='diidIOSaveItem']").toggle(!isWarn);

}

