// přeloží název úseku na AD skupinu, dle mapování v seznamu v dashboard, je potřeba nastavit oprávnění pro uživatele na tento list
function getSectionGroup(department, fnCallback) {
  if (!department && _spPageContextInfo.isSiteAdmin) {
    department = "úsek informatiky";
    TiSa.Console.Warn("Pro site admina je nastaven úsek informatiky");
  }
  var applicationUrl = _spPageContextInfo.webAbsoluteUrl.substring(0, _spPageContextInfo.webAbsoluteUrl.length - _spPageContextInfo.webServerRelativeUrl.length);
  var dashboardUrl = "/sites/dashboard";
  var ctx = new SP.ClientContext(applicationUrl + dashboardUrl);
  var web = ctx.get_web();
  var list = web.getList(dashboardUrl + "/Lists/sectionMapping");
  console.log(list);
  var caml = new SP.CamlQuery();
  caml.set_viewXml("<View><Query><Where><And><Eq><FieldRef Name='Title' /><Value Type='Text'>" + department + "</Value></Eq><Eq><FieldRef Name='daActive' /><Value Type='Boolean'>1</Value></Eq></And></Where></Query></View>");
  var items = list.getItems(caml);
  ctx.load(items);
  ctx.executeQueryAsync(function() {
    var itemsEnumerator = items.getEnumerator();
    while (itemsEnumerator.moveNext()) {
      var item = itemsEnumerator.get_current();
      var section = item.get_item("daSectionGroup");
      if (section) {
        var sectionName = section.get_lookupValue().split("\\").pop();
        fnCallback(sectionName);
      }
      return;
    }
    fnCallback(null);
  }, function(s, a) {
    TiSa.Console.Error(a.get_message());
    fnCallback(null);
  });
}