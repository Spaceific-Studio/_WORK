        console.log(division);
        form.FieldsByName.Rq_H_Department.SetValue(division);
      } else {
        alert("Nenalezena divize aktuálního uživatele!");
      }
    });

    var ctRq_All_Applicant = formContext.FindFieldControl("Rq_All_Applicant");

    ctRq_All_Applicant.OnChange(function() {
