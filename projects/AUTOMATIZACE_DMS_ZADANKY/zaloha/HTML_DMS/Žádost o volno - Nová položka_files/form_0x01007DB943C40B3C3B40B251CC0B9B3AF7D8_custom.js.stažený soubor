    if (form.IsEditableForm) {

      //var personProperties;

      var ct_Rq_H_TypeOfHoliday = formContext.FindFieldControl("Rq_H_TypeOfHoliday");
      var ct_Rq_H_ValidSince = formContext.FindFieldControl("Rq_H_ValidSince");
      var ct_Rq_H_ValidTo = formContext.FindFieldControl("Rq_H_ValidTo");
      var ct_Rq_H_ValidToHalfDay = formContext.FindFieldControl("Rq_H_ValidToHalfDay");
      var ct_Rq_H_WorkingDay = formContext.FindFieldControl("Rq_H_WorkingDay");

      var onValidRangeChange = function(o) {
        var s_start = ct_Rq_H_ValidSince.GetValue();
        var s_end = ct_Rq_H_ValidTo.GetValue();
        var table = $(".rq-h-number");
        $(".rq-h-row > .v3", table).css("visibility", "hidden");
        var start = null;
        var state = __currentState;

        var holidaysObjectCurrent = holidaysObject;
        var yearCurrent = __year;
        if (s_start) {
          start = TiSa.Forms.DateTimeUtils.ParseDateStrict(s_start, true);
          if (start && start.year() === (__year + 1)) {
            yearCurrent = __year + 1;
            holidaysObjectCurrent = holidaysObjectNext;
            state = __nextState;
          }
        }

        ct_Rq_H_ValidToHalfDay.SetReadOnly(false);
        ct_Rq_H_ValidTo.SetReadOnly(false);
        ct_Rq_H_WorkingDay.SetReadOnly(false);

        if (!start)
          return;

        // kontrola, že lze zadat maximálně 35 dní zpětně
        var dt = TiSa.Forms.DateTimeUtils.GetToday();
        if (start.unix() < dt.unix()) {
          var days = dt.diff(start, 'days');
          if (days > 35) {
            start = holidaysObjectCurrent.GetNextWorkDay(dt.add(-35, 'days'));
            ct_Rq_H_ValidSince.SetValue(start.format('l'));
          }
        }

        if (!s_end) {
          s_end = s_start;
          ct_Rq_H_ValidTo.SetValue(s_start);
        }
        var end = TiSa.Forms.DateTimeUtils.ParseDateStrict(s_end, true);
        if (!end)
          return;

        if (end.isBefore(start)) {
          end = start;
          s_end = s_start;
          ct_Rq_H_ValidTo.SetValue(s_start);
        }

        var dtYear = dt.year();
        var startY = start.year();
        var endY = end.year();

        if (startY > endY || endY - 2 > dtYear || startY + 2 < dtYear) {
          SetHolidayWarning(true, 0);
          return;
        }

        var days = holidaysObjectCurrent.GetWorkDays(start, end);
        if (days > 0 && ct_Rq_H_ValidToHalfDay.GetValue())
          days -= 0.5;

        if (!(o && o.disableUpdateWorkingDay))
          ct_Rq_H_WorkingDay.SetValue(days);

        // kontrola
        if (form.IsNewForm) {

          var days1 = days;
          var days2 = 0;

          if (end.year() > yearCurrent) {
            days1 = holidaysObjectCurrent.GetWorkDays(start, new Date(yearCurrent, 11, 31));
            days2 = holidaysObjectCurrent.GetWorkDays(new Date(yearCurrent + 1, 0, 1), end);
          }

          if (days === 0) {
            SetHolidayWarning(true, 8);
          } else {
            if (ct_Rq_H_TypeOfHoliday.GetValue() == "Dovolená") {
              if (start.year() < yearCurrent) {
                SetHolidayWarning(true, 1);
              } else if (state.total === -1) {
                SetHolidayWarning(true, 2);
              } else if (state.total === 0) {
                SetHolidayWarning(true, 7);
              } else if (days1 > state.total) {
                SetHolidayWarning(true, 3);
              } else if (end.year() > yearCurrent && __nextState.total === -1) {
                SetHolidayWarning(true, 4);
              } else if (end.year() > yearCurrent && days2 > __nextState.total) {
                SetHolidayWarning(true, 5);
              } else if (testHolidayCollisions(start.toDate(), end.toDate(), days, __currentHolidays)) {
                SetHolidayWarning(true, 6);
              } else {
                SetHolidayWarning(false, 0);
              }
            } else {
              if (testHolidayCollisions(start.toDate(), end.toDate(), days, __currentHolidays))
                SetHolidayWarning(true, 6);
              else
                SetHolidayWarning(false, 0);
            }
          }

          drawTable(fn, state, days);

          $(".rq-h-row .v3", table).css("visibility", "visible");
          //$(".rq-h-row-sum > .v3", table).text(fn(remains - days));

        }

      };

      ct_Rq_H_ValidSince.OnChange(onValidRangeChange);
      ct_Rq_H_ValidTo.OnChange(onValidRangeChange);
      ct_Rq_H_ValidToHalfDay.OnChange(function() {
        var s_start = ct_Rq_H_ValidSince.GetValue();
        var s_end = ct_Rq_H_ValidTo.GetValue();
        if (!s_start && !s_end) {
          var dt = TiSa.Forms.DateTimeUtils.GetToday();
          dt = holidaysObject.GetNextWorkDay(dt);
          ct_Rq_H_ValidSince.SetValue(dt.format("L"));
          ct_Rq_H_ValidTo.SetValue(dt.format("L"));
        }
        onValidRangeChange();
      });

      ct_Rq_H_WorkingDay.OnChange(function() {
        var n = TiSa.Forms.Utils.ParseNumber(this.GetValue());

        if (((n * 10) % 5) > 0) {
          n = Math.floor(n);
          this.SetValue(n);
        }

        var m = Math.ceil(n);

        var s_start = ct_Rq_H_ValidSince.GetValue();

        var dt = TiSa.Forms.DateTimeUtils.GetToday();
        dt = holidaysObject.GetNextWorkDay(dt);
        if (s_start) {
          dt = TiSa.Forms.DateTimeUtils.ParseDate(s_start);
        } else {
          ct_Rq_H_ValidSince.SetValue(dt.format("l"));
        }
        dt = holidaysObject.OffsetWorkDays(dt, m, true);
        ct_Rq_H_ValidToHalfDay.SetValue(n < m);
        ct_Rq_H_ValidTo.SetValue(dt.format("l"));
        onValidRangeChange({
          disableUpdateWorkingDay: true
        });
      });

      ct_Rq_H_TypeOfHoliday.OnChange(function() {
        onValidRangeChange();
      });

    }

    //divize
    form.IsUserInGroups(["Divize01", "Divize02", "Divize03", "Divize04", "Divize05", "Divize06", "Divize07", "GŘ"], function(result) {
      if (result.ValidGroupNames.length) {
