    var fnApplyHolliday = function(userId, onCompleteApplyHolliday) {
      __currentHolidays = [];
      form.EnsureClientContext(function(ctx) {
        var web = ctx.get_web();
        var list = web.get_lists().getById(form.FormContext.Context.ListAttributes.Id);
        var list2 = web.getList(_spPageContextInfo.webServerRelativeUrl + '/HolidayClaim');
        var camlQuery = new SP.CamlQuery();
        var camlQuery2 = new SP.CamlQuery();
        //var year = new Date().getFullYear();
        //var yearTo = new Date().getFullYear();
        //var userId = _spPageContextInfo.userId;
        var user = null;

        if (!form.IsNewForm) {
          if (form.IsDisplayForm)
            userId = parseInt(form.FormData.Rq_All_Applicant.split(';')[0], 0);
          else {
            if (form.FormData.Rq_All_Applicant[0])
              userId = parseInt(form.FormData.Rq_All_Applicant[0].EntityData.SPUserID, 0);
            else if (form.FormData.Author) {

              //opravovac
              userId = parseInt(form.FormData.Author.split(';')[0], 0);
              ct_Rq_All_Applicant.SetValue(userId);

              user = web.getUserById(userId);
              ctx.load(user);
            }
          }
          __year = TiSa.Forms.DateTimeUtils.ParseDate(form.FormData.Rq_H_ValidSince).year();
          //yearTo = TiSa.Forms.DateTimeUtils.ParseDate(form.FormData.Rq_H_ValidTo).year();
        }

        camlQuery.set_viewXml('<View><Query><Where>' +
          '<And>' +
          '  <Eq><FieldRef Name="Rq_All_Applicant" LookupId="TRUE" /><Value Type="Integer">' + userId + '</Value></Eq>' +
          '  <And>' +
          '    <And>' +
          '      <Neq><FieldRef Name="Rq_All_StatusChoice" /><Value Type="Text">Terminated</Value></Neq>' +
          '      <Neq><FieldRef Name="Rq_All_StatusChoice" /><Value Type="Text">Rejected</Value></Neq>' +
          '    </And>' +
          '    <Or>' +
          '      <And>' +
          '        <Geq><FieldRef Name="Rq_H_ValidSince" /><Value Type="DateTime">' + __year + '-01-01-T12:00:00Z</Value></Geq>' +
          '        <Leq><FieldRef Name="Rq_H_ValidSince" /><Value Type="DateTime">' + (__year + 1) + '-12-31-T12:00:00Z</Value></Leq>' +
          '      </And>' +
          '      <And>' +
          '        <Geq><FieldRef Name="Rq_H_ValidTo" /><Value Type="DateTime">' + __year + '-01-01-T12:00:00Z</Value></Geq>' +
          '        <Leq><FieldRef Name="Rq_H_ValidTo" /><Value Type="DateTime">' + (__year + 1) + '-12-31-T12:00:00Z</Value></Leq>' +
          '      </And>' +
          '    </Or>' +
          '  </And>' +
          '</And>' +
          '</Where></Query>' +
          '<ViewFields><FieldRef Name="Rq_H_WorkingDay" /><FieldRef Name="Rq_H_ValidSince" /><FieldRef Name="Rq_H_ValidTo" /><FieldRef Name="Rq_All_StatusChoice" /><FieldRef Name="Rq_H_TypeOfHoliday" /></ViewFields></View>');

        camlQuery2.set_viewXml('<View><Query><Where>' +
          '<And>' +
          '  <Eq><FieldRef Name="Rq_H_Employee" LookupId="TRUE" /><Value Type="Integer">' + userId + '</Value></Eq>' +
          '  <In><FieldRef Name="Rq_H_Year" /><Values><Value Type="Number">' + __year + '</Value><Value Type="Number">' + (__year + 1) + '</Value></Values></In>' +
          '</And>' +
          '</Where></Query><ViewFields><FieldRef Name="Rq_H_Year" /><FieldRef Name="Rq_H_Drawn" /><FieldRef Name="Rq_H_Remains" /><FieldRef Name="Rq_H_DrawnFree" /><FieldRef Name="Rq_H_RemainsFree" /><FieldRef Name="Rq_H_DrawnSenior" /><FieldRef Name="Rq_H_RemainsSenior" /></ViewFields></View>');

        var items = list.getItems(camlQuery);
        var items2 = list2.getItems(camlQuery2);
        ctx.load(items);
        ctx.load(items2);
        ctx.executeQueryAsync(function() {

          // opravovac
          if (user) {
            var p1 = ["employeeNumber", "employeeID", "Manager", "Title"];
            var p2 = ["Rq_H_ApplicantNumber", "Rq_H_CostCenter", "Rq_All_ApplicantManager", "Rq_H_ApplicantJobTitle"];

            if (TiSa.Forms.CurrentForm.FormData.Author.match(/[A-Za-z0-9]+\\[A-Za-z0-9]+/))

              form.GetUserProfileProperties(p1, function(data) {
                for (var i = 0; i < p1.length; i++)
                  formContext.FindFieldControl(p2[i]).SetValue(data.Properties[p1[i]]);
              }, user.get_loginName());
          }

          var itemsCollection = items.getEnumerator();

          while (itemsCollection.moveNext()) {
            var item = itemsCollection.get_current();
            var n = item.get_item('Rq_H_WorkingDay');
            var start = item.get_item('Rq_H_ValidSince');
            var end = item.get_item('Rq_H_ValidTo');
            var status = item.get_item('Rq_All_StatusChoice');
            var type = item.get_item('Rq_H_TypeOfHoliday');
            __currentHolidays.push({
              Start: start,
              End: end,
              Days: n,
              Status: status,
              Type: type
            });
          }

          var itemsCollection2 = items2.getEnumerator();

          for (var w = 0; w < __currentHolidays.length; w++) {
            var c = __currentHolidays[w];
            if (c.Status !== 'Approved' && c.Type == 'Dovolená') {
              if (c.Start.getFullYear() === __year && c.End.getFullYear() === __year)
                __currentState.forApprove += c.Days;
              if (c.Start.getFullYear() === (__year + 1) && c.End.getFullYear() === (__year + 1))
                __nextState.forApprove += c.Days;
            }
          }

          while (itemsCollection2.moveNext()) {
            var item = itemsCollection2.get_current();
            var y = item.get_item('Rq_H_Year');
            var o = __currentState;
            if (y == (__year + 1))
              o = __nextState;

            o.drawn = fv(item, 'Rq_H_Drawn');
            o.drawnFree = fv(item, 'Rq_H_DrawnFree');
            o.drawnSenior = fv(item, 'Rq_H_DrawnSenior');

            o.remains = fv(item, 'Rq_H_Remains');
            o.remainsFree = fv(item, 'Rq_H_RemainsFree');
            o.remainsSenior = fv(item, 'Rq_H_RemainsSenior');

            o.total = o.remains + o.remainsFree + o.remainsSenior;

            // odečtení neschválené
            if (o.total > 0) {
              o.total -= o.forApprove;
              if (o.total < 0)
                o.total = 0;
            }
          }

          var ct_Rq_H_WorkingDay = formContext.FindFieldControl("Rq_H_WorkingDay");
          var days = ct_Rq_H_WorkingDay.GetValue() || 0;
          drawTable(fn, __currentState, days);

          if (form.IsNewForm) {
            if (__currentState.total <= 0 && __nextState.total > 0)
              SetHolidayWarning(true, 9);
            else if (__currentState.total === -1)
              SetHolidayWarning(true, 2);
            else if (__currentState.total === 0)
              SetHolidayWarning(true, 7);
            else
              SetHolidayWarning(false, 0);
          }
          if (onCompleteApplyHolliday)
            onCompleteApplyHolliday();

        }, function(sender, args) {});
      });
    };

