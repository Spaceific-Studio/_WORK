    var WFProxyOnprem = /** @class */ (function () {
        function WFProxyOnprem() {
        }
        WFProxyOnprem.prototype.Initialize = function (callback) {
            if (callback) {
                callback();
            }
        };
        WFProxyOnprem.prototype.ExecuteAction = function (data, completed, onExecuted) {
            if (!window._spFormDigestRefreshInterval) {
                WriteError("Workflow action ERROR:' _spFormDigestRefreshInterval is not defined");
                return;
            }
            UpdateFormDigest(_spPageContextInfo.webServerRelativeUrl, _spFormDigestRefreshInterval);
            if (data == null)
                data = "";
            if (data.length > 0)
                data += "&";
            data += "lng=" + _spPageContextInfo.currentLanguage;
            WriteLog("Workflow action START: " + data);
            $j.ajax({
                url: _spPageContextInfo.webAbsoluteUrl + "/_layouts/15/WFEngine/Service.aspx",
                data: data,
                method: "post",
                cache: false,
                headers: {
                    "X-RequestDigest": $j('#__REQUESTDIGEST').val(),
                    "cache-control": "no-cache"
                },
                success: function (c) {
                    WriteLog("Workflow action SUCCESS: " + data);
                    completed(c);
                },
                error: function (e) {
                    WriteError("Workflow action ERROR: " + data);
                    WriteError(e);
                }
            });
            if (onExecuted)
                setTimeout(onExecuted, 100);
        };
        return WFProxyOnprem;
    }());
