        Manager.HandleResponseWithNotification = function (resp, action, notifySuccess, notifyError, optionalRedirectArgs) {
            if (resp.Res == "ok") {
                SP.UI.Notify.addNotification(notifySuccess, false);
            }
            else if (resp.Res == "redirect") {
                window.location.assign(resp.Url + (optionalRedirectArgs ? "&" + optionalRedirectArgs : "") + "&source=" + encodeURIComponent(window.location.toString()));
            }
            else {
                WriteError("Workflow action '" + action + "' error:");
