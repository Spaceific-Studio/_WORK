            if (data === void 0) { data = null; }
            if (onExecuted === void 0) { onExecuted = null; }
            var me = this;
            this.EnsureProxy(function () {
                if (_spPageContextInfo.webId && _spPageContextInfo.siteId) {
                    // SPO obsahuje vlastnosti v _spPageContextInfo, zbytečně dělat dotaz navíc
