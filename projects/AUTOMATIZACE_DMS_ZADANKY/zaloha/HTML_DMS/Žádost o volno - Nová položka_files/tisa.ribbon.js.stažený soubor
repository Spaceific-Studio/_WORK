    var _FindCurrentTab = function () {
        var tabId = "";
        switch (_form.FormContext.Context.FormControlMode) {
            case SPClientTemplates.ClientControlMode.DisplayForm:
                tabId = "Ribbon.ListForm.Display";
                break;
            case SPClientTemplates.ClientControlMode.NewForm:
            case SPClientTemplates.ClientControlMode.EditForm:
                switch (_form.FormContext.Context.ListAttributes.ListTemplateType) {
                    case 100: // generics list
                        tabId = "Ribbon.ListForm.Edit";
                        break;
                    case 101: // document library
                        tabId = "Ribbon.DocLibListForm.Edit";
                        break;
                }
                break;
        }

        var tab = _ribbon.getChild(tabId);
        if (tab == null)
            tab = _ribbon.getChild("Ribbon.ListForm.Edit");
        return tab;
    };


