    this.AddBrowseGroup = function (id, listId, browseData) {

        var config = {
            CurrentId: id,
            CurrentListId: listId,
            CurrentIndex: -1,
            BrowseData: browseData,
            FindIndex: function () {
                if (this.CurrentIndex >= 0)
                    return this.CurrentIndex;
                if (this.BrowseData.IsTaskForm) {
                    var taskid = parseInt(GetUrlKeyValue("TaskId"));
                    for (var i = 0; i < this.BrowseData.Data.length; i++) {
                        var item = this.BrowseData.Data[i];
                        if (this.CurrentId === item.id && this.CurrentListId.replace(/-/g, '') === item.list.replace(/-/g, '') && taskid === item.taskid) {
                            this.CurrentIndex = i;
                            return i;
                        }
                    }
                }
                else {
                    for (var i = 0; i < this.BrowseData.Data.length; i++) {
                        var item = this.BrowseData.Data[i];
                        if (this.CurrentId === item.id && this.CurrentListId.replace(/-/g, '') === item.list.replace(/-/g, '')) {
                            this.CurrentIndex = i;
                            return i;
                        }
                    }
                }
                return -1;
            },
            Enable: function (btnIndex) {
                var ix = this.FindIndex();
                if ((ix === 0 && btnIndex === 0) || (ix === (this.BrowseData.Data.length - 1) && btnIndex === 1))
                    return false;
                return true;
            },
            Command: function (btnIndex) {
                var ix = this.FindIndex();
                btnIndex === 0 ? ix-- : btnIndex === 1 ? ix++ : ix;
                var item = this.BrowseData.Data[ix];
                var href = null;
                if (this.BrowseData.IsTaskForm) {
                    href = item.taskurl;
                }
                else {
                    var listInfo = this.BrowseData.ListInfo[item.list];
                    var page = window.location.href.indexOf("DispForm.aspx") > 0 ? listInfo.DefaultDisplayUrl : listInfo.DefaultEditUrl;
                    href = page + "?ID=" + item.id;
                }
                window.location.href = href;
            },
            Next: function () {
                if ((this.CurrentIndex + 1) < this.BrowseData.Data.length) {
                    this.Command(1);
                    return false;
                }
                return true;
            },
            Prev: function () {
                if (this.CurrentIndex > 0) {
                    this.Command(0);
                    return false;
                }
                return true;
            }
        };
        

        _Initialize(function () {
            if (_createdBrowseGroup)
                return;
            _createdBrowseGroup = true;

            

            config.ComponentInstance = new __initialize_BrowseComponent(config);

            //
            // prepare layout
            var idPrefix = "TiSa.Browse.";
            var tab = _FindCurrentTab();

            if (tab == null)
                return;
                     

            var group = tab.getChild("Ribbon.ListForm.Display.Actions") || tab.getChild("Ribbon.ListForm.Edit.Actions") || tab.getChild("Ribbon.DocLibListForm.Edit.Actions");
            if (group == null)
                return;

            

            var cp = new CUI.ControlProperties();
            cp.Command = idPrefix + 'ButtonPrev.Command';
            cp.Id = idPrefix + 'ButtonPrev';
            cp.TemplateAlias = 'o1';
            cp.Image32by32 = _baseUrl + '/Forms/Left.png';
            cp.ToolTipTitle = browseData.IsTaskForm ? RESX.Ribbon_Browse_btnPrevTask : RESX.Ribbon_Browse_btnPrev;
            cp.ToolTipDescription = browseData.IsTaskForm ? RESX.Ribbon_Browse_btnPrevDescriptionTask : RESX.Ribbon_Browse_btnPrevDescription;
            cp.LabelText = cp.ToolTipTitle
            var buttonPrev = new CUI.Controls.Button(_ribbon, cp.Id, cp);

            cp = new CUI.ControlProperties();
            cp.Command = idPrefix + 'ButtonNext.Command';
            cp.Id = idPrefix + 'ButtonNext';
            cp.TemplateAlias = 'o1';
            cp.Image32by32 = _baseUrl + '/Forms/Right.png';
            cp.ToolTipTitle = browseData.IsTaskForm ? RESX.Ribbon_Browse_btnNextTask : RESX.Ribbon_Browse_btnNext;
            cp.ToolTipDescription = browseData.IsTaskForm ? RESX.Ribbon_Browse_btnNextDescriptionTask : RESX.Ribbon_Browse_btnNextDescription;
            cp.LabelText = cp.ToolTipTitle
            var buttonNext = new CUI.Controls.Button(_ribbon, cp.Id, cp);
             

            var layout = group.get_selectedLayout();
            var section1 = new CUI.Section(_ribbon, idPrefix + 'SectionBrowse', 2, 'Top');
            layout.addChildAtIndex(section1, 1);


            var section1row1 = section1.getRow(1);
            section1row1.addChild(buttonPrev.createComponentForDisplayMode('Large'));     
            section1row1.addChild(buttonNext.createComponentForDisplayMode('Large'));  
        });

        return config;
    };

