    var _ValidateButtonConfig = function (button) {


        if (!button.GroupId)
            button.GroupId = button.GroupID;
        if (!button.GroupId)
            button.GroupId = TiSa.Environment.CreateGuid();

        if (!button.Id)
            button.Id = button.ID;
        if (!button.Id)
            button.Id = TiSa.Environment.CreateGuid();

        if (!button.GroupTitle)
            button.GroupTitle = "";
        if (!button.Title)
            button.Title = "";
        if (!button.ToolTipTitle)
            button.ToolTipTitle = button.Title;
        if (!button.ToolTipDescription)
            button.ToolTipDescription = button.ToolTipTitle;
        if (!button.Icon)
            button.Icon = "_layouts/15/images/placeholder32x32.png";
        if (!button.Icon16)
            button.Icon16 = "_layouts/15/images/placeholder16x16.png";
        if (!button.Visible)
            button.Visible = true;

        if (button.GroupTitle.indexOf("RESX.") == 0) {
            button.GroupTitleResource = button.GroupTitle;
            var r = eval(button.GroupTitleResource);
            if (r)
                button.GroupTitle = r;
        }

        if (button.Title.indexOf("RESX.") == 0) {
            button.TitleResource = button.Title;
            var r = eval(button.TitleResource);
            if (r)
                button.Title = r;
        }

        if (button.ToolTipTitle.indexOf("RESX.") == 0) {
            button.ToolTipTitleResource = button.ToolTipTitle;
            var r = eval(button.ToolTipTitleResource);
            if (r)
                button.ToolTipTitle = r;
        }

        if (button.ToolTipDescription.indexOf("RESX.") == 0) {
            button.ToolTipDescriptionResource = button.ToolTipDescription;
            var r = eval(button.ToolTipDescriptionResource);
            if (r)
                button.ToolTipDescription = r;
        }

        return button;
    };

    var _CreateCustomButton = function (tabInstance, groupInstance, buttonConfig) {
        for (var i = 0; i < _customButtonsConfig.RibbonButtons.length; i++) {
            var bb = _customButtonsConfig.RibbonButtons[i];
            if (bb.Id == buttonConfig.Id)
                return bb;
        }

        var id = _customButtonsConfig.Prefix + buttonConfig.Id + ".Button";

        var cp = new CUI.ControlProperties();
        cp.Command = id + '.Command';
        cp.Id = id;
        cp.TemplateAlias = 'o1';
        cp.Image32by32 = buttonConfig.Icon ? buttonConfig.Icon.replace("{SiteCollectionUrl}", TiSa.Environment.SiteServerRelativeUrl) : '_layouts/15/images/placeholder32x32.png';
        cp.Image16by16 = buttonConfig.Icon16 ? buttonConfig.Icon.replace("{SiteCollectionUrl}", TiSa.Environment.SiteServerRelativeUrl) : '_layouts/15/images/placeholder16x16.png';
        cp.ToolTipTitle = buttonConfig.ToolTipTitle;
        cp.ToolTipDescription = buttonConfig.ToolTipDescription;
        cp.LabelText = buttonConfig.Title;
        var button = new CUI.Controls.Button(_ribbon, cp.Id, cp);

        var section1row1 = groupInstance.Section1.getRow(1);
        section1row1.addChild(button.createComponentForDisplayMode('Large'));

        if (!groupInstance.SectionIndex || groupInstance.SectionIndex > 3)
            groupInstance.SectionIndex = 1;
        var section2row = groupInstance.Section2.getRow(groupInstance.SectionIndex);
        section2row.addChild(button.createComponentForDisplayMode('Medium'));
        var section3row = groupInstance.Section3.getRow(groupInstance.SectionIndex);
        section3row.addChild(button.createComponentForDisplayMode('Small'));

        var b = {
            Config: buttonConfig,
            Id: buttonConfig.Id,
            Group: groupInstance,
            Button: button,
            Tab: tabInstance
        }
        groupInstance.Buttons.push(b);
        groupInstance.SectionIndex++;

        _customButtonsConfig.RibbonButtons.push(b);

        return b;
