    this.UpdateRibbonForTaskForm = function (s, e) {
        var tab = _FindCurrentTab();
        //console.dir(tab);
        _ribbon.removeChild("Ribbon.WebPartPage");
        tab.get_enabled = function () {
            return true;
        };
        $(document.getElementById(tab.get_id())).children().each(function (i, em) {
            if ($(em).attr("id").indexOf("TiSa.") != 0) {
                tab.removeChild($(em).attr("id"));
            }
        });
        this.Refresh();
    }

