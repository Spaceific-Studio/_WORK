    var _Initialize = function (initializeCallbackFunction) {
        if (_initialized) {
            $(document).trigger("tisa-ribbon-initialized", { Ribbon: _ribbon, Form: _form, RibbonComponent: _this });
            initializeCallbackFunction();
            return;
        }

        if (_ribbonInstance == null) {
            // async
            _ribbonInitCallBacks.push(initializeCallbackFunction);

            SP.SOD.executeOrDelayUntilScriptLoaded(function () {
                _pageInEditMode = SP.Ribbon.PageState.Handlers.isInEditMode();
                if (_pageInEditMode)
                    return;

                _ribbonInstance = SP.Ribbon.PageManager.get_instance();
                _ribbonDispatcher = _ribbonInstance.get_commandDispatcher();
                _ribbon = _ribbonInstance.get_ribbon();
                if (!_ribbon) {
                    _ribbonInstance.add_ribbonInited(function () {
                        _ribbon = _ribbonInstance.get_ribbon();
                        _initialized = true;
                        $(document).trigger("tisa-ribbon-initialized", { Ribbon: _ribbon, Form: _form, RibbonComponent: _this });
                        for (var i = 0; i < _ribbonInitCallBacks.length; i++)
                            _ribbonInitCallBacks[i]();
                    });
                }
                else {
                    _initialized = true;
                    $(document).trigger("tisa-ribbon-initialized", { Ribbon: _ribbon, Form: _form, RibbonComponent: _this });
                    for (var i = 0; i < _ribbonInitCallBacks.length; i++)
                        _ribbonInitCallBacks[i]();
                    //initializeCallbackFunction();
                }

            }, 'SP.Ribbon.js');
        }
        else {
            _pageInEditMode = SP.Ribbon.PageState.Handlers.isInEditMode();
            if (_pageInEditMode)
                return;

            if (!_ribbon) {
                _ribbonInitCallBacks.push(initializeCallbackFunction);
                _ribbonInstance.add_ribbonInited(function () {
                    _ribbon = _ribbonInstance.get_ribbon();
                    _initialized = true;
                    for (var i = 0; i < _ribbonInitCallBacks.length; i++)
                        _ribbonInitCallBacks[i]();
                });
            }
            else {
                _initialized = true;
                $(document).trigger("tisa-ribbon-initialized", { Ribbon: _ribbon, Form: _form, RibbonComponent: _this });
                initializeCallbackFunction();
            }

        }
    };

    this.Refresh = function () {
