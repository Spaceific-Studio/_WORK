    TiSa.Utils.GetElementsByClassName = function (element, className) {
        if (!element.getElementsByClassName) {
            var elems = element.querySelectorAll ? element.querySelectorAll("." + className) : (function () {
                var all = element.getElementsByTagName("*"),
                    elements = [],
                    i = 0;
                for (; i < all.length; i++) {
                    if (all[i].className && (" " + all[i].className + " ").indexOf(" " + className + " ") > -1 && indexOf.call(elements, all[i]) === -1) elements.push(all[i]);
                }
                return elements;
            })();
            return elems;
        }
        else
            return element.getElementsByClassName(className);

    };

    TiSa.Utils.Filter = function (arr, f) {
        if (!Array.prototype.filter) {
            var r = [];
            for (var i = 0; i < this.length; i++)
                if (f(this[i]))
                    r.push(f(this[i]));
            return r;
        }
        else
            return arr.filter(f);
    };



