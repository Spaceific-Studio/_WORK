                if (handler === null || data === null)
                    return;

                if (_appHostWindow) {
                    _callbackIndex++;
                    _callbackFunctions[_callbackIndex] = callbackFunction;
                    _callbackErrorFunctions[_callbackIndex] = callbackErrorFunction;
                    //var originalUrl = TiSa.Environment.SiteServerUrlEncoded.replace(":://", "://");
