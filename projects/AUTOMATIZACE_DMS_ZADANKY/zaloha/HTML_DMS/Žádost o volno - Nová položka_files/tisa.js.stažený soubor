                    var url = _spPageContextInfo.webAbsoluteUrl + "/SiteAssets/TiSa/_Shared/LicenseExpired.html";
                    // license expired
                    return '<a href="' + url + '" target="_blank" class="licenseExpiredAlert">TreeINFO license expired.</a>';
