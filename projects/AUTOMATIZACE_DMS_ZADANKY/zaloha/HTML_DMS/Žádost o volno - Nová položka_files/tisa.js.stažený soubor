    TiSa.Utils.NintexWorkflow_StartWorkflowOnItem = function (listId, itemId, workflowName, useStartPage, callbackFunction, callbackErrorFunction) {
        var context = {
            ClientContext: null,
            Web: null,
            List: null,
            Item: null,
            NotifyId: null
        };
        var notifText = useStartPage ? "Opening workflow for" : "Starting workflow ";
        var notif = "<img src='" + "/_layouts/15/images/loadingcirclests16.gif?rev=23" + "' style='vertical-align:bottom; display:inline-block; margin-" + (document.documentElement.dir == 'rtl' ? 'left' : 'right') + ":2px;' />&nbsp;<span style='vertical-align:top;'>" + notifText + " <b>" + workflowName + "</b> ..." + "</span>";
        context.NotifyId = SP.UI.Notify.addNotification(notif, true);

        context.ClientContext = SP.ClientContext.get_current();
        context.Web = context.ClientContext.get_web();
        context.List = context.Web.get_lists().getById(listId);
        context.Item = context.List.getItemById(itemId);

        var wfa = context.List.get_workflowAssociations().getByName(workflowName);
        if (useStartPage)
            context.ClientContext.load(context.Item, "UniqueId");
        else
            context.ClientContext.load(context.Item, "FileRef");
        context.ClientContext.load(wfa, "Id", "AssociationData");

        var ctx = {
            Context: context,
            WorkflowAssociation: wfa,
            UseStartPage: useStartPage,
            ListId: listId,
            ItemId: itemId,
            WorkflowName: workflowName
        };

        context.ClientContext.executeQueryAsync(
            Function.createDelegate(ctx, function () {
                if (useStartPage) {
                    var qp = {
                        List: listId,
                        ID: itemId,
                        ItemGuid: "{" + this.Context.Item.get_item("UniqueId").toString() + "}",
                        TemplateID: "{" + this.WorkflowAssociation.get_id().toString() + "}",
                        Source: encodeURIComponent(location.href)
                    };
                    var url = _spPageContextInfo.webAbsoluteUrl + '/_layouts/15/NintexWorkflow/StartWorkflow.aspx?' + TiSa.Environment.BuildQueryString(qp);
                    window.location.href = url;
                }
                else {
                    var webserviceUrl = _spPageContextInfo.siteAbsoluteUrl + '/_vti_bin/NintexWorkflow/Workflow.asmx';
                    var wfad = this.WorkflowAssociation.get_associationData().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&apos;');
                    var soapRequest = '<?xml version="1.0" encoding="utf-8"?>' +
                        '<soap:Envelope xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">' +
                        '<soap:Header>' +
                        '</soap:Header>' +
                        '<soap:Body>' +
                        '<StartWorkflow xmlns="http://nintex.com">' +
                        '<fileUrl>' + this.Context.Item.get_item("FileRef") + '</fileUrl>' +
                        '<workflowName>' + this.WorkflowName + '</workflowName>' +
                        '<associationData>' + wfad + '</associationData>' +
                        '</StartWorkflow>' +
                        '</soap:Body>' +
                        '</soap:Envelope>';

                    $.ajax({
                        type: "POST",
                        url: webserviceUrl,
                        contentType: "text/xml; charset=\"utf-8\"",
                        dataType: "xml",
                        data: soapRequest,
                        success: Function.createDelegate(this, function () {
                            SP.UI.Notify.removeNotification(this.Context.NotifyId);
                            SP.UI.Notify.addNotification("Workflow <b>" + this.WorkflowName + "</b> execution was started.", false);
                            if (callbackFunction)
                                callbackFunction();
                        }),
                        error: Function.createDelegate(this, function () {
                            SP.UI.Notify.removeNotification(this.Context.NotifyId);
                            SP.UI.Notify.addNotification("<span style=\"color:red\">Workflow <b>" + this.WorkflowName + "</b>' an error has occurred!</span>", false);
                            if (callbackErrorFunction)
                                callbackErrorFunction();
                        }),
                        headers: {
                            "X-RequestDigest": $("#__REQUESTDIGEST").val()
                        }
                    });
                }
            }),
            Function.createDelegate(ctx, function (sender, args) {
                SP.UI.Notify.removeNotification(this.Context.NotifyId);
                //alert('Error occurred: ' + args.get_message());
                if (callbackErrorFunction)
                    callbackErrorFunction();
            }));
    };


