                var context = {
                    FieldInfo: fieldInfoObject,
                    TemplateContext: TiSa.Templates.CopyTemplateContext(ctx),
                    FormContext: formCtx,
                    ControlMode: controlMode,
                    ControlId: TiSa.Templates.GetControlId(formCtx, controlMode)
                };
                if (controlMode == SPClientTemplates.ClientControlMode.View) {
                    var fn = ctx.OnPostRender;
                    ctx.OnPostRender = function (a) {
                        if (fn) {
                            if (fn instanceof Array) {
                                for (var i = 0; i < fn.length; i++)
