        if (!v)
            return v;

        //var wd = 0;
        while ((match = new RegExp(_regexParseTemplateTokens, "gi").exec(v)) !== null) {
            tokens.push(match[0]);
            templateNames.push(match[3]);
            //wd++;
            //if (wd > 1000)
            break;
        }

        if (tokens.length > 0) {
            var result = this.GetTemplates(templateNames, function (res) {

                var els = TiSa.Utils.GetElementsByClassName(document, "tisa-textTemplateTokenRequest");
                for (var i = 0; i < els.length; i++) {
