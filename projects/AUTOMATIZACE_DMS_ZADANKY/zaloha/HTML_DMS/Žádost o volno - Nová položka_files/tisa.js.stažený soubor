                else {
                    if (_waitingFunctions.length > 1000) {
                        TiSa.Console.Log("_waitingFunctions overflow");
                        return;
                    }

                    _waitingFunctions.push({
                        Handler: handler,
                        Data: data,
                        WebGet: false,
                        CallbackFunction: callbackFunction,
