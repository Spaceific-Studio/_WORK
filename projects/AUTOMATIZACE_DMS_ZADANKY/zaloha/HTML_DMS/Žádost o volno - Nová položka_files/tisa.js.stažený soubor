    TiSa.JSOM.FindWebByUrl = function (clientContext, webUrl, fnSuccess, fnError) {

        webUrl = webUrl.replace("{SiteUrl}", _spPageContextInfo.siteServerRelativeUrl.replace(/\/$/, ""))
                       .replace("{WebUrl}", _spPageContextInfo.webServerRelativeUrl.replace(/\/$/, ""));

        if (webUrl.indexOf(_spPageContextInfo.siteAbsoluteUrl) == 0) {
            // convert to relative url
            var domain = _spPageContextInfo.siteAbsoluteUrl.substring(0, _spPageContextInfo.siteAbsoluteUrl.length - _spPageContextInfo.siteServerRelativeUrl.length);
            webUrl = webUrl.substring(domain.length);
        }

        var _clientContext = clientContext;
        var _site = clientContext.get_site();
        var _rootWeb = _site.get_rootWeb();
        var _webUrl = webUrl;
        var _rootUrl = _spPageContextInfo.siteServerRelativeUrl.replace(/\/+$/, "");
        var idx = _webUrl.indexOf(_rootUrl);

        if (idx < 0)
            throw new Error("Url '" + _webUrl + "' is not valid for this site.");

        var _subUrlSegments = _webUrl.replace(/\/+$/, "").substring(_rootUrl.length).replace(/^\/+/, "").split('/');

        if (_subUrlSegments.length == 0) {
            fnSuccess(_rootWeb);
            return;
        }

        var _findWeb = function (web, segmentsCount, fnSuccess, fnError) {
            var _currentWeb = web;
            var _currentFnSuccess = fnSuccess;
            var _currentFnError = fnError;
            var _currentSegmentsCount = segmentsCount;
            var _testUrl = _rootUrl + '/' + _subUrlSegments.splice(0, _currentSegmentsCount).join('/');

            var _subWebs = _currentWeb.getSubwebsForCurrentUser(new SP.SubwebQuery());
            _clientContext.load(_currentWeb, 'ServerRelativeUrl');
            _clientContext.load(_subWebs, 'Include(ServerRelativeUrl)');
            _clientContext.executeQueryAsync(function () {
                var subWebsCollection = _subWebs.getEnumerator();
                var ww = [];
                while (subWebsCollection.moveNext()) {
                    var subWeb = subWebsCollection.get_current();
                    var subWebUrl = subWeb.get_serverRelativeUrl().toLowerCase();
                    if (subWebUrl == _testUrl.toLowerCase()) {
                        ww.push(subWeb);
                    }
                }
                if (ww.length == 0) {
                    _currentFnSuccess(_currentWeb);
                    return;
                }

                for (var i = 0; i < ww.length; i++) {
                    var w = ww[i];
                    _findWeb(w, _currentSegmentsCount + 1, _currentFnSuccess, _currentFnError);
                }

            }, function (ctx, e) {
                _currentFnError(ctx, e);
            });
        };

        _findWeb(_rootWeb, 1, fnSuccess, fnError);
    };

