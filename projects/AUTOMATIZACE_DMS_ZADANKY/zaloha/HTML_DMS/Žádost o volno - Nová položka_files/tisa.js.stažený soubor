        if (_currentModalDialog != null) {
            _currentModalDialog.Dialog.close();
            for (var i = 0; i < _currentModalDialog.CallbackFunctions.length; i++) {
                var fn = _currentModalDialog.CallbackFunctions[i];
                fn(_currentModalDialog.ResultData);
            }
            _currentModalDialog = null;
        }
    };

    TiSa.Environment.EnsureGlobalDipatcher = function () {
        if (!_currentDispatcher)
            _currentDispatcher = new tisa_dialog_dispatcher();
        return _currentDispatcher;
    };

    TiSa.Environment.OnMessage = [];

    function tisa_dialog_dispatcher() {
        var _dispatchEvent = function (event, tisaMessage) {
            var source = event.source;
            var origin = event.origin;
            switch (tisaMessage.Method) {
                case "CloseModalDialog":
                    if (_currentModalDialog !== null) {
                        _currentModalDialog.ResultData = tisaMessage.Data;
                    }
                    TiSa.Environment.CloseModalDialog();
                    break;
                case "DialogArgsRequest":
                    if (_currentModalDialog !== null) {
                        var args = _currentModalDialog.Dialog.get_args();
                        tisaMessage.Data = args;
                        var resultData = {
                            Message: tisaMessage,
                            Data: args
                        };
                        source.postMessage(JSON.stringify(resultData), origin);
                        return true;
                    }
                    break;
                case "ExecuteCode":
                    for (var i = 0; i < TiSa.Environment.OnMessage.length; i++)
                        TiSa.Environment.OnMessage[i](tisaMessage);
                    break;
            }
            return false;
        };

        $(window).on("message", function (e) {
            var oe = e.originalEvent;
            if (oe.data !== "undefined" && oe.data !== null && oe.data.indexOf("{") === 0) {
                try {
                    var dispatched = false;
                    var tisaMessage = JSON.parse(oe.data);
                    if (tisaMessage.Method && tisaMessage.SenderId) {
                        dispatched = _dispatchEvent(oe, tisaMessage);
                    }

                    // post message to all subdialogs (SP FIX)
                    if (!dispatched) {
