                            }

                            if (proxyReadyCallback)
                                proxyReadyCallback();
                            if (_readyFunctions.length > 0) {
                                for (var i = 0; i < _readyFunctions.length; i++) {
                                    var f = _readyFunctions[i];
                                    if (f)
                                        f.call();
                                }
                            }
                            if (_waitingFunctions.length > 0) {
                                for (var i = 0; i < _waitingFunctions.length; i++) {
                                    var f = _waitingFunctions[i];
                                    if (f.IsHandler)
                                        _this.CallHandler(f.FieldType, f.Handler, f.Data, f.CallbackFunction, f.CallbackErrorFunction);
                                    else
                                        _this.CallUrl(f.FieldType, f.Handler, f.Data, f.WebGet, f.CallbackFunction, f.CallbackErrorFunction);

                                }
                            }
                            _waitingFunctions = [];
                            return;
                        }
                        else if (responseObject.Data === "redirect") {
                            if (reloading)
                                return;
                            reloading = true;

                            if (reloads >= 10) {
                                TiSa.Console.Error("wnd: proxy not loaded!");
                                return;
                            }

                            setTimeout(function () {
                                if (!_appHostWindow) {
                                    _frame.attr("src", "");
                                    setTimeout(function () {
                                        TiSa.Console.Debug("wnd " + _token + ": reload frame " + reloads);

                                        url = TiSa.Environment.GetApplicationUrl("/Pages/ProxyHandler.aspx", fieldType) + "&token=" + _token + "&userid=" + _spPageContextInfo.userId + "&SessionID=" + responseObject.SessionId + "&r=" + reloads;
                                        _frame.attr("src", url);
                                        reloads++;
                                        reloading = false;
                                    }, 0);
                                }
                            }, reloads * 1500);
                            return;
                        }

                        // retrieve callback function by index
                        var callbackFunction = _callbackFunctions[responseObject.Index];
                        delete _callbackFunctions[responseObject.Index];
                        var callbackErrorFunction = _callbackErrorFunctions[responseObject.Index];
                        delete _callbackErrorFunctions[responseObject.Index];

                        if (responseObject.IsError && callbackErrorFunction) {
                            callbackErrorFunction({
                                Error: responseObject.Error,
                                TextStatus: responseObject.TextStatus
                            });
                        }
                        else {
                            if (callbackFunction)
                                callbackFunction(responseObject.Data);
                        }
                    }
                }
            };

            $(window).on("message", function (e) {
                var oe = e.originalEvent;
                if (oe.data === "undefine\d" || oe.data == null)
                    return;
                if (oe.data.indexOf && oe.data.indexOf("<") == 0)
                    return;
                var responseObject = null;
                if (oe.data.indexOf && oe.data.indexOf("{") == 0)
                    responseObject = JSON.parse(oe.data);
                if (responseObject)
                    receiveDataFunction(oe, responseObject);
            });

            //TiSa.Dispatcher.OnReceiveMessage(receiveDataFunction);

            this.GetFrame = function () { return _frame; };
            return this;
        };



        TiSa.Environment.__ProxyTokenIndex++;
        var proxyObj = new create_ProxyObject(fieldType.ComponentAppUrl, proxyReadyCallback);

        TiSa.Environment.__ProxyList[fieldType.ComponentAppUrl] = proxyObj;
        TiSa.Console.Debug("Create proxy " + fieldType.ComponentAppUrl);
        //container.after(proxyObj.GetFrame()); // toto je problem
        $(document.body).append(proxyObj.GetFrame());
        return new create_ProxyObjectWrapper(proxyObj, fieldType);
    };

    // override filter values on view
    TiSa.Templates.OverrideCSRFilter = function (targetFieldName, overrideTextValueFunction) {
        var l = window._OnIframeLoad;

        var _OnIframeLoadExtension = function () {
            if (!filterTable)
                return;
            var fieldName = filterTable.getAttribute('Name');
            if (fieldName == targetFieldName) {
                var iframe = document.getElementById("FilterIframe" + filterTable.getAttribute('CtxNum'));
                if (iframe != null) {
                    var iframeDoc = null;
                    if (typeof iframe.contentDocument != "undefined")
                        iframeDoc = iframe.contentDocument;
                    if (iframeDoc == null && null != iframe.contentWindow)
                        iframeDoc = iframe.contentWindow.document;
                    if (iframeDoc == null) {
                        iframeDoc = iframe.ownerDocument;
                    }
                    if (iframeDoc != null) {
                        var select = iframeDoc.getElementById("diidFilter" + fieldName);
                        if (select != null) {
                            var rgChoices = select.childNodes;
                            var c = select.childNodes.length;

                            for (var i = 1; i < c; i++) {
                                var strMenuText;
                                if (rgChoices[i].innerText)
                                    strMenuText = rgChoices[i].innerText;
                                else if (rgChoices[i].textContent)
                                    strMenuText = rgChoices[i].textContent;
                                else
                                    strMenuText = rgChoices[i].innerHTML;
                                rgChoices[i].innerHTML = overrideTextValueFunction(strMenuText);
                            }
                        }
                    }
                }
            }
            l.call(window);
        };
        window._OnIframeLoad = _OnIframeLoadExtension;
    };





    var _regexParseResourceTokens = new RegExp("\\{RESX\.([$\\w\\s_\\-]+)\\}", "gi");

    TiSa.Templates.ReplaceResources = function (v, RESX) {
        var names = [];
        var match;
        if (!v)
            return v;

        while ((match = _regexParseResourceTokens.exec(v)) !== null) {
            names.push(match[1]);
        }

        if (names.length > 0) {
            for (var i = 0; i < names.length; i++) {
                var token = names[i];
                var name = names[i];
                if (RESX[name]) {
                    var res = RESX[name];
                    v = v.replace("{RESX." + name + "}", res);
                }
            }
        }
        return v;
    };

    TiSa.Templates.ReplaceFormulaInExpression = function (str) {
        if (!str)
            return str;

        if (!str.indexOf)
            return str;

        var a = str.indexOf('[[');
        if (a === -1)
            return str;

        var i = 0;
        while (a >= 0) {
            i++;

            a = str.indexOf('[[');
            if (a === -1)
                break;

            var b = str.indexOf(']]', a);

            if (b > a) {
                for (var k = b + 2; k < str.length; k++) {

                    if (str[k] === ']')
                        continue;
                    b = k - 2;
                    break;
                }

                var v = str.substring(a + 2, b);
                var r = '';
                try {
                    r = eval(v).toString();
                }
                catch (e) {
                    // some err
                }
                str = str.substring(0, a) + r + str.substring(b + 2);
            }
            if (i > 10)
                break;
        }
        return str;
    };

