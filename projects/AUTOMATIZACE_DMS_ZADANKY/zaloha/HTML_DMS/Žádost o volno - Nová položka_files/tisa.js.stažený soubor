            var vv = [];
            var r = [];
            for (var tt in _textTemplates) {
                var o = _textTemplates[tt];
                if (o.State === 0) {
                    vv.push('<Value Type="Text">' + o.Name + '</Value>');
                    o.State = 1;
                    r.push(o);
                }
            }

            var camlQuery = new SP.CamlQuery();
            camlQuery.set_viewXml('<View><ViewFields><FieldRef Name="tisa_Text_TemplateName" /><FieldRef Name="tisa_Text_Template" /></ViewFields><Query><Where><And><Eq><FieldRef Name="tisa_Text_TemplateType" /><Value Type="Text">0</Value></Eq><In><FieldRef Name="tisa_Text_TemplateName" /><Values>' + vv.join('') + '</Values></In></And></Where></Query></View>');
            var items = list.getItems(camlQuery);
            ctx.load(items);
            ctx.executeQueryAsync(function () {
                var itemsCollection = items.getEnumerator();
                while (itemsCollection.moveNext()) {
                    var item = itemsCollection.get_current();
                    var name = item.get_item("tisa_Text_TemplateName");
                    var textTemplate = JSON.parse(item.get_item("tisa_Text_Template"));
                    var content = textTemplate.Content;
                    if (textTemplate.ContentResource && textTemplate.ContentResource[TiSa.LCID.toString()])
                        content = textTemplate.ContentResource[TiSa.LCID.toString()];
                    _textTemplates[name].Content = content;
                    _textTemplates[name].State = 2; // loaded
                }
                for (var i = 0; i < r.length; i++)
                    if (r[i].State === 1)
                        r[i].State = 3;
                for (var i = 0; i < _textTemplates_CallbackFunctions.length; i++) {
                    var fn = _textTemplates_CallbackFunctions[i];
                    if (fn.Function)
                        fn.Function.call(fn.Sender, _textTemplates_FilterTemplates(fn.Names));
                }
                _textTemplates_CallbackFunctions = [];
            }, function (ctx, e) {
                for (var i = 0; i < _textTemplates_CallbackFunctions.length; i++) {
                    var fn = _textTemplates_CallbackFunctions[i];
                    if (fn.FunctionError)
                        fn.FunctionError.call(fn.Sender, ctx, e);
                }
            });


        });
        return null;
    };

    TiSa.TextTemplates.ReplaceText = function (v) {
