                    var a = el.getAttribute("data-textTemplateName");
                    if (res[a]) {
                        var content = res[a];
                        if (content)
                            el.innerHTML = content;
                        else
                            el.innerHTML = "";
                        el.className = "tisa-textTemplateToken";
                    }
                    else {
                        el.className = "tisa-textTemplateTokenUnresolved";
                    }
                }
            });

            for (var i = 0; i < tokens.length; i++) {
