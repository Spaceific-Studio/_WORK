    TiSa.Utils.IndexOf = function (arr, obj, start) {
        if (!Array.prototype.indexOf) {
            for (var i = (start || 0), j = arr.length; i < j; i++) {
                if (arr[i] === obj) { return i; }
            }
            return -1;
        }
        else
            return arr.indexOf(obj, start);
