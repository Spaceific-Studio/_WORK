    TiSa.Environment.GetValidName = function (name, maxLength, isFile, removeDiacritics) {
        if (!name)
            return name;
        if (removeDiacritics)
            name = TiSa.Environment.RemoveDiacritics(name);

        if (!maxLength)
            maxLength = 80;
        if (!isFile)
            isFile = false;
        var newName = name.replace(/^[\.\s]+|[\.\s]+$/g, '');
        if (isFile) {
            var ext = "tmp";
            var idx = newName.lastIndexOf('.', newName.Length - 1, Math.min(newName.Length, 6));
            if (idx > 0) {
                ext = newName.substring(idx + 1);
                newName = newName.substring(0, idx);
            }
            ext = "." + TiSa.Environment.GetValidName(ext, 6);
            newName = TiSa.Environment.GetValidName(newName, maxLength - ext.length);
            return newName + ext;
        }

        newName = newName.replace(/\#|\%|\*|\:|\<|\>|\?|\/|\||\`"|\'|\&|\{|\}|\\|\$|\@|\!/g, '_');
        newName = newName.replace(/_+/g, '_');
        newName = newName.replace(/_\s+|\s_+/g, ' ');
        newName = newName.replace(/\.+/g, '.');
        newName = newName.replace(/\s+/g, ' ');
        newName = newName.replace(/^[\.\s]+|[\.\s]+$/g, '');

        if (newName.Length == 0)
            newName = Guid.NewGuid().ToString();
        var ix = 16;
        if ((newName.length > maxLength) && ((maxLength - ix - 3) > 0))
            newName = newName.substring(0, maxLength - ix - 3) + "..." + newName.substring(newName.length - ix);
        if (newName.length > maxLength)
            newName = newName.substring(0, maxLength);

        return newName;
    };

