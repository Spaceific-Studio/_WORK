    TiSa.TextTemplates.GetTemplates = function (templateNames, callbackFunction, callbackFunctionError) {
        if (typeof templateNames === 'string' || templateNames instanceof String)
            templateNames = [templateNames];

        _textTemplates_InitializeCompiledTemplates();

        var result = {};
        var anyQueryRequired = false;
        var anyQueryProgress = false;
        for (var i = 0; i < templateNames.length; i++) {
            var k = templateNames[i];

            var t = _textTemplates[k];
            if (!t) {
                t = {
                    State: 0,
                    Name: k,
                    Content: null
                };
                _textTemplates[k] = t;
                anyQueryRequired = true;
            }
            else {
                if (t.State === 2) {
                    result[k] = t.Content;
                }
                else if (t.State === 3) {
                    continue; // not found
                }
                else {
                    anyQueryProgress = true;
                    continue;
                }
            }
        }
        if (anyQueryProgress) {
            _textTemplates_CallbackFunctions.push({
                Function: callbackFunction,
                FunctionError: callbackFunctionError,
                Sender: this,
                Names: templateNames
            });
            return null;
        }

        if (!anyQueryRequired) {
            if (callbackFunction)
                callbackFunction(result);
            return result;
        }

        _textTemplates_CallbackFunctions.push({
            Function: callbackFunction,
            FunctionError: callbackFunctionError,
            Sender: this,
            Names: templateNames
        });

        TiSa.JSOM.EnsureClientContext(function (ctx) {
            var web = ctx.get_site().get_rootWeb();
            //var list = web.get_lists().getById(TiSa.Environment.TextTemplateListId);
