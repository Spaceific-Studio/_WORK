                        v = v.replace(new RegExp('<a href="[^>]*>([^<>]*)</a>', 'ig'), "$1");
                        // SP FIX - decode        		
                        v = v.replace(/\&quot;/g, "\"");
                        // SP FIX - decode
                        v = v.replace(/\&lt;/g, "<").replace(/\&gt;/g, ">");
                    }

                    switch (this.FieldType) {
                        case "SPFieldBoolean":
                            return v && (v == "1" || v.toLowerCase() == "ano" || v.toLowerCase() == "yes") ? "1" : "0";
                        default:
                            return v;
                    }
                }
            }
            return "";
        },
        GetDisplayValue: function (callBackFunction) {
            if (callBackFunction)
                updateFieldControl(this, function () {
                    var v = this.GetDisplayValue();
                    callBackFunction.call(this, v);
                });

            var v = this.GetValue();
            if (!v)
                v = "";
            switch (this.FieldType) {
                case "SPFieldUser":
                    var input = this.GetInput();
                    if (input != null) {
                        var uu = input.GetAllUserInfo();
                        var r = [];
                        for (var i = 0; i < uu.length; i++)
                            if (uu[i].DisplayText)
                                r.push(uu[i].DisplayText);
                        return r.join(", ");
                    }
                    else {
                        this.GetInput(function (input) {
                            if (input != null && callBackFunction) {
                                var uu = input.GetAllUserInfo();
                                var r = [];
                                for (var i = 0; i < uu.length; i++)
                                    if (uu[i].DisplayText)
                                        r.push(uu[i].DisplayText);
                                callBackFunction(r.join(", "));
                            }
                        });
                        return null;
                    }
                    break;
                case "SPFieldTaxonomyFieldType":
                    return v.split("|")[0];
                case "SPFieldTaxonomyFieldTypeMulti":
                    var arr = v.split(";");
                    var arr2 = [];
                    for (var i = 0; i < arr.length; i++)
                        arr2.push(arr[i].split('|')[0]);
                    return arr2.join('; ');
            }
            return v;
        },
