        OnChange: function (ev, init) {
            if (!this.Editable)
                return;

            var _this = this;

            updateFieldControl(this, function () {
                if (_this.TiSaControl != null) {
                    if (_this.TiSaControl.Control.OnChanged)
                        _this.TiSaControl.Control.OnChanged(function () {
                            ev.call(_this, _this.TiSaControl.Control);
                        });
                    if (init)
                        ev.call(_this, _this.TiSaControl.Control);
                    return;
                }

                switch (this.FieldType) {
                    case "SPFieldTaxonomyFieldType":
                    case "SPFieldTaxonomyFieldTypeMulti":
                        var input = this.GetInput();
                        if (!input)
                            return;
                        // TODO nefunguje přes picker
                        RTE.CanvasEvents.registerListener(RTE.CanvasEvents.editableRegionChangedEvent, function TiSa_SPFieldTaxonomyField_Evt(sender, args) {
                            var er = args.editableRegion;
                            ev.call(_this, input, er);
                        });
                        if (init)
                            ev.call(_this, input, null);
                        break;
                    case "SPFieldUser":
                    case "SPFieldUserMulti":
                        this.GetInput(function (input) {
                            if (!input)
                                return;

                            var fn = function (element, users) {
                                ev.call(_this, input, users);
                            };
                            if (!input.OnValueChangedClientScript)
                                input.OnValueChangedClientScript = fn;
                            else {
                                var fnPrev = input.OnValueChangedClientScript;
                                input.OnValueChangedClientScript = function (element, users) {
                                    fn(element, users);
                                    fnPrev(element, users);
                                };
                            }
                            if (init)
                                ev.call(_this, input, input.GetAllUserInfo());
                        });
                        break;
                    case "SPFieldBoolean":
                        var input = this.GetInput();
                        if (!input)
                            return;
                        input.on("change", function () {
                            ev.call(_this, input, this);
                        });
                        if (init)
                            ev.call(_this, input, null);
                        break;
                    case "SPFieldChoice":
                        var input = this.GetInput();
                        if (!input || input.length === 0)
                            return
                        if (input.length && input[0].localName.toLowerCase() === "select") {
                            input.on("change", function () {
                                ev.call(_this, input, this);
                            });
                        }
                        else {
                            input.on("change keyup input", function () {
                                ev.call(_this, input, this);
                            });
                        }
                        if (init)
                            ev.call(_this, input, null);
                        break;
                    default:
                        var input = this.GetInput();
                        if (!input || input.length === 0)
                            return
                        input.on("change keyup input", function () {
                            ev.call(_this, input, this);
                        });
                        if (init)
                            ev.call(_this, input, null);
                        break;
                }
            });
        },
