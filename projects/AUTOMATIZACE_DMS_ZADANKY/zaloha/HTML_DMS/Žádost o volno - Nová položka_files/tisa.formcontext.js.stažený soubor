                                parent = el.closest("table");
                                t.insertAfter(parent);
                                var opts = $("option", el);
                                var vals = "";
                                for (var i = 0; i < opts.length; i++) {
                                    if (i > 0)
                                        vals += "; ";
                                    vals += opts[i].innerHTML;
                                }
                                //el.on("change", null, onSelectMultiChange);
                                t.text(vals);
                                break;
                            case 'SPFieldNote':
                                if (el.is("textarea")) {
                                    t.css("white-space", "pre-wrap");
                                    el.on("change", null, onInputChange);
                                    t.text(el.val());
                                }
                                else {
                                    var editor = $(".ms-rtestate-field", el);
                                    editor.on("change", function () {
                                        t.html(elInner.html());
