                                if (input.length > 0) {
                                    // select
                                    toogleState(input, state);
                                }
                                else {
                                    // radio
                                    var radios = $("input[type=radio]", this.TableCell);
                                    //radios.attr("disabled", state);
                                    for (var i = 0; i < radios.length; i++) {
                                        var radio = radios[i];
                                        $(radio).closest("tr").toggleClass("tisa-hidden", state && !radio.checked);
                                        $(radio).toggleClass("tisa-hidden", state);
                                    }
                                }
                                break;
                            case 'SPFieldMultiChoice':
                                var checkboxes = $("input[type=checkbox]", this.TableCell);
                                for (var i = 0; i < checkboxes.length; i++) {
                                    var checkbox = checkboxes[i];
                                    $(checkbox).closest("tr").toggleClass("tisa-hidden", state && !checkbox.checked);
                                    $(checkbox).toggleClass("tisa-hidden", state);
                                }
                                break;
                            case 'SPFieldLookupMulti':
                                var input = $("select[id$=SelectResult]", this.TableCell);
                                toogleState(input, state);
                                break;
                            case 'SPFieldFile':
                                var input = $("input:first", this.TableCell);
                                toogleState(input, state);
                                break;
                            case 'SPFieldBoolean':
                                var input = $("input:first", this.TableCell);
                                if (state)
                                    input.attr("disabled", "disabled");
                                else
                                    input.removeAttr("disabled");
                                break;
                            case 'SPFieldUser':
                            case 'SPFieldUserMulti':
                                var input = $("select:first", this.TableCell);
                                if (input.length > 0) {
                                    if (state)
                                        input.attr("disabled", "disabled");
                                    else
                                        input.removeAttr("disabled");
