TiSa.Forms.GetFormTable = function () {
    var elements = TiSa.Utils.GetElementsByClassName(document, "ms-formtable");
    if (elements.length > 0)
        return elements[0];
    return null;
};

TiSa.Forms._CurrentFormContext = null;

TiSa.Forms.GetFormControlContext = function () {
    if (TiSa.Forms._CurrentFormContext !== null)
