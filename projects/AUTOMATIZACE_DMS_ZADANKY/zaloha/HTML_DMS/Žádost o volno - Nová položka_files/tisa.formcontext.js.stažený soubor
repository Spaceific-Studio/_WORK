                }

                // disable/enable validators
                if (this.Validators) {
                    for (var i = 0; i < this.Validators.length; i++) {
                        var validator = this.Validators[i];
                        if (validator.SetDisabled)
                            validator.SetDisabled(state);
                    }
                }

                if (this.TiSaControl != null) {
                    if (this.TiSaControl.Control.SetReadOnly)
                        this.TiSaControl.Control.SetReadOnly(state);
                    else
                        warnMethodMissing(this.TiSaControl, "SetReadOnly");
                }
                else {
                    if (this.Editable) {
                        switch (this.FieldType) {
                            case 'SPFieldURL':
                            case 'SPFieldCurrency':
                            case 'SPFieldInteger':
                            case 'SPFieldNumber':
                            case 'SPFieldText':
                                var input = $("input[type!=hidden]:first", this.TableCell);
                                toogleState(input, state);
                                break;
                            case 'SPFieldDateTime':
                                var input = $("table", this.TableCell);
                                toogleState(input, state);
                                break;
                            case 'SPFieldNote':
                                var input = $("textarea:first", this.TableCell);
                                if (input.length > 0)
                                    toogleState(input, state);
                                else {
