        wp = document.getElementById("WebPartWPQ2"); //flexiform
    if (!wp)
        wp = document.getElementById("WebPartWPQ1"); // online

    if ($(".ms-formtable", wp).length == 0) {
        wp = document.getElementById("WebPartWPQ1"); // online        
    }

    if (!wp) {
        if (window.console && window.console.debug)
            window.console.debug("WebPart not found");
        return;
    }

    formControlContext.Qualifier = wp.id.substring(wp.id.indexOf("WebPart") + "WebPart".length);
    formControlContext.Form = SPClientForms.ClientFormManager.GetClientForm(formControlContext.Qualifier);
    formControlContext.Context = window[formControlContext.Qualifier + "FormCtx"];
    if (!formControlContext.Context)
        return null;

    //formControlContext.Form

    formControlContext.Fields = [];
    formControlContext.FieldsByName = {};

    //var elements = TiSa.Utils.GetElementsByClassName(wp, "ms-formtable");    

    var table = null;
    var tables = $(".ms-formtable", wp);
    for (var i = 0; i < tables.length; i++) {
        if ($(tables[i]).parent().closest(".ms-formtable").length == 0) {
            table = $(tables[i]);
            break;
        }
    }
    formControlContext.Table = table; //  TiSa.Forms.GetFormTable();

    function updateFieldControl(fieldControl, callbackFunction) {
        // instance jiz byla ziskana
        if (fieldControl._fieldControlUpdated) {
            if (callbackFunction)
                callbackFunction.call(fieldControl);
            return;
        }

        // instance je vytvorena
        if (TiSa.Templates.Controls.hasOwnProperty(fieldControl.InternalName)) {
            fieldControl.TiSaControl = TiSa.Templates.Controls[fieldControl.InternalName];
            fieldControl._fieldControlUpdated = true;
            if (callbackFunction)
                callbackFunction.call(fieldControl);
            return;
        }

        // instance bude vytvorena pozdeji
        if (TiSa.Templates.RegisteredFields.hasOwnProperty(fieldControl.InternalName)) {
            TiSa.Templates.RegisteredFields[fieldControl.InternalName].AddInitializeCallbackFunctions(function () {
                fieldControl.TiSaControl = TiSa.Templates.RegisteredFields[fieldControl.InternalName].ControlReference;
                fieldControl._fieldControlUpdated = true;
                if (callbackFunction)
                    callbackFunction.call(fieldControl);
                return;
            });
            return;
        }

        // instance neobsahuje control
        fieldControl._fieldControlUpdated = true;
        if (callbackFunction)
            callbackFunction.call(fieldControl);
    }

    function warnMethodMissing(control, methodName) {
        TiSa.Console.Warn("Control template '" + control.Control.constructor.name + "' does not have method '" + methodName + "'.");
    }

    function warnNotImplemented(methodName, msg) {
        TiSa.Console.Warn("Warning implementation for method: " + methodName + ". " + msg);
    }

