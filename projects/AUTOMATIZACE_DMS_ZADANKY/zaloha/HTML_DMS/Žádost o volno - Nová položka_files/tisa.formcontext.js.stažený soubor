                if (inst && inst.HasAsyncLoad && inst.HasAsyncLoad()) {
                    inst.OnInitialAsyncLoadComplete.push(callBackFunction);
                    return;
                }
                callBackFunction.call(inst);
            });
            if (!r)
                callBackFunction.call(null);
        },
