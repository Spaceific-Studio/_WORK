                            this.Validators = [];
                        requiredValidator = new TiSa.Forms.ClientValidation.RequiredValidator();
                        requiredValidator.CheckForEmptyArray = this.FieldType.indexOf("SPFieldUser") == 0;
                        requiredValidator.Control = this;
                        var valSet = new SPClientForms.ClientValidation.ValidatorSet();
