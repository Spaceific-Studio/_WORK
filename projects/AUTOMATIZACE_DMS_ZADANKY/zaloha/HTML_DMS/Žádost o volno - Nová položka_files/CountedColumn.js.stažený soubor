    //Calls handler to get new values of counters.
    var _ComputeValue = function () {
        var expression = _GetExpression();
        if (!expression) {
            //_InitClientValue(false);
            return;
        }
        if (_config.DisableEvaluateOnClient)
            return;

        // pokud je conditional expresion nemusí být validator vždy potřeba
        if (_validator) {
            if (expression.indexOf("{$") < 0)
                _validator.SetEnabled(false);
            else
                _validator.SetEnabled(true);
        }

        _countedValue = _EvaluateExpression(expression);

        _controlValue.val(_countedValue);
        _controlValue.trigger("change");
        if (_initialAsyncLoading && _sourceData.IsComplete()) {
            _initialAsyncLoading = false;
            for (var i = 0; i < _this.OnInitialAsyncLoadComplete.length; i++) {
                var fn = _this.OnInitialAsyncLoadComplete[i];
                if (fn)
                    fn.call(_this);
            }
        }

        // copy to sync field
        if (!_initialAsyncLoading && _config.SyncElement) {
            var se = _config.SyncElement;
            var tes = se.TargetElement.split(/[\s,;\|]+/);
            for (var i = 0; i < tes.length; i++) {
                var ctrl = _formControlContext.FindFieldControl(tes[i]);
                if (ctrl !== null) {
                    var v = se.Expression.replace(/\{value\}/gi, _countedValue);
                    v = _EvaluateExpression(v);
                    ctrl.SetValue(v);
                    if (se.Hidden)
                        ctrl.SetHidden(true);
                    if (se.ReadOnly)
                        ctrl.SetReadOnly(true);
                }
            }
        }
    };

    var _ResolveRootFolder = function () {
        if (_rootFolder == null) {
            if (_isNewForm)
                _rootFolder = _formControlContext.Context.NewItemRootFolder;
            else {
                if (_formContext.itemAttributes.Url)
                    _rootFolder = _formContext.itemAttributes.Url.substring(0, _formContext.itemAttributes.Url.lastIndexOf('/'));
            }
            if (_rootFolder == null) {
                var uri = parseUri(location.href);
                _rootFolder = decodeURIComponent(uri.queryKey.RootFolder);
            }
        }
    };

    var _CallClientRequest = function (callbackFunction) {
        var expression = _GetExpression();
        if (!expression)
            return;
        if (expression.indexOf("{folder") >= 0 || expression.indexOf("{parentfolder") >= 0 ||
            expression.indexOf("{folderproperty") >= 0 || expression.indexOf("{listproperty") >= 0 || expression.indexOf("{webproperty") >= 0) {
            SP.SOD.executeFunc('sp.js', 'SP.ClientContext', function () {
                var context = SP.ClientContext.get_current();
                var web = context.get_web();
                _ResolveRootFolder();

                var list = web.get_lists().getById(_formContext.listAttributes.Id);
                var listRootFolder = list.get_rootFolder();

                var webProperties = null;
                var listProperties = null;
                var folderProperties = null;

                context.load(listRootFolder, "ServerRelativeUrl");

                var folderItem = null;
                var folder = null;

                if (_rootFolder && _rootFolder.length > 0 && (expression.indexOf("{folder") >= 0 || expression.indexOf("{parentfolder") >= 0)) {
                    folder = web.getFolderByServerRelativeUrl(_rootFolder);
                    folderItem = folder.get_listItemAllFields();
                    context.load(folder, "ServerRelativeUrl");
                    context.load(folderItem);
                }

                if (expression.indexOf("{listproperty") >= 0) {
                    listProperties = listRootFolder.get_properties();
                    context.load(listProperties);
                }
                if (expression.indexOf("{webproperty") >= 0) {
                    webProperties = web.get_allProperties();
                    context.load(webProperties);
                }
                if (_rootFolder && _rootFolder.length > 0 && expression.indexOf("{folderproperty") >= 0) {
                    if (folder == null)
                        folder = web.getFolderByServerRelativeUrl(_rootFolder);
                    folderProperties = folder.get_properties();
                    context.load(folderProperties);
                }
                else if (expression.indexOf("{listproperty") >= 0)
                    folderProperties = listProperties;

                context.executeQueryAsync(
                    function () {
                        var properties = {
                            Folder: folderProperties,
                            List: listProperties,
                            Web: webProperties
                        };

                        if (folder == null || folderItem == null) {
                            callbackFunction(null, null, properties);
                            return;
                        }

                        var isRoot = listRootFolder.get_serverRelativeUrl() == folder.get_serverRelativeUrl();
                        if (isRoot) {
                            callbackFunction(null, null, properties);
                            return;
                        }

                        var folderData = folderItem.get_fieldValues();

                        if (expression.indexOf("{parentfolder") >= 0) {
                            var parentFolder = folder.get_parentFolder();
                            var parentFolderItem = parentFolder.get_listItemAllFields();
                            context.load(parentFolder, "ServerRelativeUrl");
                            context.load(parentFolderItem);
                            context.executeQueryAsync(function () {
                                var isRoot2 = listRootFolder.get_serverRelativeUrl() == parentFolder.get_serverRelativeUrl();
                                if (isRoot2) {
                                    callbackFunction(folderData, null, properties);
                                    return;
                                }
                                var parentFolderData = parentFolderItem.get_fieldValues();
                                callbackFunction(folderData, parentFolderData, properties);
                            }, function (sender, args) {
                                TiSa.Console.Error("Problem in getting folder data. Receive this error '" + args.get_message() + "'");
                                //alert("Problem in getting parent folder data. Receive this error '" + args.get_message() + "'");
                            });
                        }
                        else {
                            callbackFunction(folderData, null, properties);
                            return;
                        }
                    },
                    function (sender, args) {
                        TiSa.Console.Error("Problem in getting folder data. Receive this error '" + args.get_message() + "'");
                        //alert("Problem in getting folder data. Receive this error '" + args.get_message() + "'");
                    });
            });
        }
        else {
            callbackFunction(null, null, null);
        }
    }

    //Get values of other fields of the record and replace them in the mask
    var _formControlContext = null;
    var _GetFormColumns = function () {
        _EnsureRegexBank();
        var re = _staticContext.RegexBank.Column;
        var arr = [];

        var fnAddTokens = function (expression) {
            var o = TiSa.TemplateEvaluator.ParseTemplate(expression);
            for (var k in o) {
                if (k.indexOf("$") === 0)
                    continue;
                if (arr.indexOf(k) < 0)
                    arr.push(k);
            }
        };

        //var expression = _GetExpression();
        //if (!expression)
        //    return arr;

        if (_config.ConditionalExpressions) {
            for (var i = 0; i < _config.ConditionalExpressions.length; i++) {
                var e = _config.ConditionalExpressions[i];
                fnAddTokens(e.Condition);
                fnAddTokens(e.Expression);
            }
        }

        if (_config.Expression)
            fnAddTokens(_config.Expression);
        return arr;
    }


    var _EnsureRegexBank = function () {
        if (_staticContext.RegexBank == null) {
            _staticContext.RegexBank = {};
            _staticContext.RegexBank.Global = "\\{[^\\}]+\\}";
            _staticContext.RegexBank.Date = "\\{date\\:([^\\}]+)\\}";
            _staticContext.RegexBank.ParentFolder = "\\{parentfolder\\:([\\w]+)\\}";
            _staticContext.RegexBank.Folder = "\\{folder\\:([\\w]+)\\}";
            _staticContext.RegexBank.FolderProperty = "\\{folderproperty\\:([\\w]+)\\}";
            _staticContext.RegexBank.WebProperty = "\\{webproperty\\:([\\w]+)\\}";
            _staticContext.RegexBank.ListProperty = "\\{listproperty\\:([\\w]+)\\}";
            _staticContext.RegexBank.Column = "\\{([\\w]+)\\}";
            _staticContext.RegexBank.Formula = "\\[\\[([^[]+)\\]\\]";
        }
    }

